# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
# machine-readable test artifacts (regenerated every run; evidence lives in docs/baseline/quality-report.json)
/results/

# temporary files
.tmp*
.tmp-*/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
*.log
dev_out.log
server.log
start-server.bat
/public/uploads/**
!/public/uploads/.gitkeep

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env*.local
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# playwright & tests
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/screenshots/


cloudflared.exe
*.exe

# Database
prisma/*.db
prisma/*.db-journal


# Testing Artifacts
playwright-report/
test-results/
screenshots/
snapshots/
audit-screenshots/
scripts/*.png
*.ans
captcha_*
after_submit*.png
login_preview*.png
.superdesign
  
# Parto portal session (human-in-the-loop capture, never commit)  
.parto-portal-state.json  
.env*

# Supplier portal capture bundles (local parser calibration artifacts)
api_hunt/

.zcode/
.claude/

# Graphify knowledge graph artifacts
graphify-out/
.graphify*

