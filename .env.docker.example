# ==============================================================================
# Docker Environment Configuration Template for Firuzo / iTrip Platform
# Copy this file to .env.docker or .env before running docker compose
# ==============================================================================

# ==================== 1. Service Ports (Host to Container) ====================
# Customize these ports if standard ports are already in use on your host machine
APP_PORT=3000
DB_PORT=5432
REDIS_PORT=6379
ADMINER_PORT=8080

# ==================== 2. Database (PostgreSQL 16) ====================
POSTGRES_USER=postgres
DB_PASSWORD=firuzo_secure_password_2026!
POSTGRES_DB=itrip

# Database host:
# - 'db' for internal docker compose network (default)
# - 'host.docker.internal' to connect to a database running on host machine
# - External IP/Hostname for managed cloud DB (RDS, Arvan, Liara, etc.)
DB_HOST=db

# Full Database URL (automatically constructed in docker-compose.yml if left commented)
# DATABASE_URL="postgresql://postgres:firuzo_secure_password_2026!@db:5432/itrip?schema=public"

# ==================== 3. Cache & Queue (Redis 7) ====================
REDIS_HOST=redis
REDIS_PORT=6379

# ==================== 4. Security & Authentication ====================
# Generate with: openssl rand -base64 32
AUTH_SECRET="kw5uW6Ry8QMeXKfj8xDzbiRVVKvGo_7sRGEGhsI9mMIg0z5mJm8Ix8HxGpbHbhCO"
AUTH_TRUST_HOST="true"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Initial Administrative Passwords
ADMIN_PASSWORD="Admin@Firuzo2026!"
USER_PASSWORD="User@Firuzo2026!"

# ==================== 5. Operational Modes ====================
# Set to 'true' only in local mock test; MUST be 'false' in production builds
DEMO_MODE="false"
NEXT_PUBLIC_DEMO_MODE="false"

# Set to 'true' if migrations are managed outside container startup
SKIP_DB_MIGRATION="false"

# Gateway Mode (internal_wallet, ecardo, shetab, sandbox)
GATEWAY_MODE="internal_wallet"

# ==================== 6. External Integrations (Optional) ====================
# Messaging & Bots
BALE_BOT_TOKEN=""
NEXT_PUBLIC_BALE_BOT_USERNAME=""
TELEGRAM_BOT_TOKEN=""
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=""
WECHAT_APP_ID=""
WECHAT_APP_SECRET=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# SMS Providers (smswbs, kavenegar, faraz)
SMS_PROVIDER="smswbs"
SMSWBS_USERNAME=""
SMSWBS_PASSWORD=""
SMSWBS_SENDER=""
SMS_SENDER_LINE=""
SMS_OTP_LINE=""
SMS_PATTERN_CODE=""

# Payment Gateways (Ecardo multi-currency)
ECARDO_BASE_URL="https://ecardo.ir"
ECARDO_PUBLIC_KEY=""
ECARDO_SECRET_KEY=""
