// Prisma Schema for iTrip/Firuzo Travel Platform - MySQL/MariaDB Master Model
// Single Source of Truth for Production, Staging, CI and Development

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.1.x", "debian-openssl-1.1.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ==================== 1. Identity & RBAC ====================

model User {
  id             String   @id @default(cuid()) @db.VarChar(191)
  email          String?  @unique @db.VarChar(191)
  phone          String?  @unique @db.VarChar(191)
  telegramId     String?  @unique @db.VarChar(191)
  whatsappPhone  String?  @unique @db.VarChar(191)
  wechatId       String?  @unique @db.VarChar(191)
  baleId         String?  @unique @db.VarChar(191)
  name           String?  @db.VarChar(191)
  firstNameFa    String?  @db.VarChar(191)
  lastNameFa     String?  @db.VarChar(191)
  firstNameEn    String?  @db.VarChar(191)
  lastNameEn     String?  @db.VarChar(191)
  role           String   @default("CUSTOMER") @db.VarChar(50) // SUPER_ADMIN, FINANCE, OPS, CUSTOMER
  passwordHash   String?  @db.VarChar(255)
  isActive       Boolean  @default(true)
  avatar         String?  @db.Text
  nationalId     String?  @db.VarChar(50)
  passportNo     String?  @db.VarChar(50)
  passportExpiry String?  @db.VarChar(50)
  language       String   @default("fa") @db.VarChar(10)
  currency       String   @default("IRR") @db.VarChar(10)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  auditLogs               AuditLog[]
  bookings                Booking[]
  trips                   Trip[]
  userRoles               UserRole[]
  organizationMemberships OrganizationMembership[]
  travelerProfiles        TravelerProfile[]
  autoBuyRules            AutoBuyRule[]
  referralCodes           ReferralCode[]
}

// B2B & Organization Structure (IAM-003)
model Organization {
  id              String   @id @default(cuid()) @db.VarChar(191)
  type            String   @default("AGENCY") @db.VarChar(50) // AGENCY, CORPORATE, PARTNER, INTERNAL
  legalName       String   @db.VarChar(255)
  displayName     String   @db.VarChar(255)
  registrationNo  String?  @db.VarChar(100)
  taxNo           String?  @db.VarChar(100)
  status          String   @default("ACTIVE") @db.VarChar(50) // ACTIVE, SUSPENDED, PENDING
  defaultCurrency String   @default("IRR") @db.VarChar(10)
  timezone        String   @default("Asia/Tehran") @db.VarChar(100)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  memberships       OrganizationMembership[]
  branches          OrganizationBranch[]
  bookings          Booking[]
  trips             Trip[]
  invoices          Invoice[]
  settlementBatches SettlementBatch[]
  travelDocuments   TravelDocument[]

  @@index([status])
}

model OrganizationBranch {
  id             String   @id @default(cuid()) @db.VarChar(191)
  organizationId String   @db.VarChar(191)
  name           String   @db.VarChar(255)
  code           String?  @db.VarChar(50)
  timezone       String   @default("Asia/Tehran") @db.VarChar(100)
  status         String   @default("ACTIVE") @db.VarChar(50)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization      Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members           OrganizationMembership[]
  bookings          Booking[]
  trips             Trip[]
  invoices          Invoice[]
  settlementBatches SettlementBatch[]
  travelDocuments   TravelDocument[]

  @@index([organizationId])
}

model OrganizationMembership {
  id             String   @id @default(cuid()) @db.VarChar(191)
  organizationId String   @db.VarChar(191)
  userId         String   @db.VarChar(191)
  roleId         String?  @db.VarChar(191)
  branchId       String?  @db.VarChar(191) // Optional branch-level scoping (IAM-003)
  status         String   @default("ACTIVE") @db.VarChar(50) // ACTIVE, INVITED, SUSPENDED
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch       OrganizationBranch? @relation(fields: [branchId], references: [id], onDelete: SetNull)
  role         Role?               @relation(fields: [roleId], references: [id], onDelete: SetNull)

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([branchId])
  @@index([roleId])
}

// Traveler Profiles & Travel Documents (IAM-002)
model TravelerProfile {
  id          String   @id @default(cuid()) @db.VarChar(191)
  userId      String   @db.VarChar(191)
  firstName   String   @db.VarChar(100)
  lastName    String   @db.VarChar(100)
  nationalId  String?  @db.VarChar(50)
  dateOfBirth String?  @db.VarChar(50) // YYYY-MM-DD
  gender      String?  @db.VarChar(20) // MALE, FEMALE, OTHER
  nationality String   @default("IR") @db.VarChar(10)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents TravelDocument[]

  @@index([userId])
}

model TravelDocument {
  id                String   @id @default(cuid()) @db.VarChar(191)
  travelerProfileId String   @db.VarChar(191)
  organizationId    String?  @db.VarChar(191) // B2B Multi-tenancy (IAM-103)
  branchId          String?  @db.VarChar(191) // B2B Branch Scoping (IAM-103)
  type              String   @db.VarChar(50) // PASSPORT, NATIONAL_ID, VISA, DRIVER_LICENSE
  documentNumber    String   @db.VarChar(100)
  issuingCountry    String   @default("IR") @db.VarChar(10)
  issuedAt          String?  @db.VarChar(50) // YYYY-MM-DD
  expiresAt         String?  @db.VarChar(50) // YYYY-MM-DD
  holderName        String?  @db.VarChar(255)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  travelerProfile TravelerProfile     @relation(fields: [travelerProfileId], references: [id], onDelete: Cascade)
  organization    Organization?       @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  branch          OrganizationBranch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([travelerProfileId])
  @@index([organizationId])
  @@index([branchId])
  @@index([documentNumber])
}

model Role {
  id          String  @id @default(cuid()) @db.VarChar(191)
  name        String  @unique @db.VarChar(100) // e.g. SUPER_ADMIN, FINANCE_OPS
  permissions String? @default("[]") @db.Text // Deprecated: relational RolePermission is canonical (IAM-106)
  description String? @db.Text

  userRoles               UserRole[]
  rolePermissions         RolePermission[]
  organizationMemberships OrganizationMembership[]
}

model Permission {
  id          String  @id @default(cuid()) @db.VarChar(191)
  code        String  @unique @db.VarChar(100) // e.g. "booking.read", "booking.refund.approve"
  name        String  @db.VarChar(191)
  module      String  @db.VarChar(50) // "BOOKING", "FINANCE", "INVENTORY", "SUPPLIER", "OPS"
  description String? @db.Text

  rolePermissions RolePermission[]

  @@index([module])
}

model RolePermission {
  roleId       String @db.VarChar(191)
  permissionId String @db.VarChar(191)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserRole {
  userId String @db.VarChar(191)
  roleId String @db.VarChar(191)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

// ==================== 2. Core: Double-Entry Ledger & Payments ====================

// Chart of Accounts & Journals (FIN-001, FIN-002)
model ChartOfAccounts {
  id        String   @id @default(cuid()) @db.VarChar(191)
  code      String   @unique @db.VarChar(50) // e.g. "1010", "2010", "4010"
  name      String   @db.VarChar(191) // e.g. "Cash & Bank", "Customer Escrow", "Service Revenue"
  category  String   @db.VarChar(50) // ASSET, LIABILITY, EQUITY, REVENUE, EXPENSE
  currency  String   @default("IRR") @db.VarChar(10)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  journals JournalEntry[]
  lines    JournalLine[]

  @@index([category])
}

model JournalEntry {
  id               String   @id @default(cuid()) @db.VarChar(191)
  entryNumber      String   @unique @db.VarChar(100) // e.g. JE-2026-0001
  chartOfAccountId String   @db.VarChar(191)
  date             DateTime @default(now())
  description      String   @db.Text
  referenceType    String?  @db.VarChar(50) // BOOKING, REFUND, SETTLEMENT, ADJUSTMENT
  referenceId      String?  @db.VarChar(191)
  createdAt        DateTime @default(now())

  account ChartOfAccounts @relation(fields: [chartOfAccountId], references: [id])
  lines   JournalLine[]

  @@index([date])
  @@index([referenceType, referenceId])
}

model JournalLine {
  id               String  @id @default(cuid()) @db.VarChar(191)
  journalEntryId   String  @db.VarChar(191)
  chartOfAccountId String  @db.VarChar(191)
  direction        String  @db.VarChar(20) // DEBIT, CREDIT
  debit            Decimal @default(0) @db.Decimal(20, 4)
  credit           Decimal @default(0) @db.Decimal(20, 4)
  amount           Decimal @db.Decimal(20, 4)
  currency         String  @default("IRR") @db.VarChar(10)
  memo             String? @db.Text

  journalEntry JournalEntry    @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account      ChartOfAccounts @relation(fields: [chartOfAccountId], references: [id])

  @@index([journalEntryId])
  @@index([chartOfAccountId])
}

model Account {
  id        String @id @default(cuid()) @db.VarChar(191)
  ownerType String @db.VarChar(50) // USER, PLATFORM_ESCROW, PLATFORM_FEE, PLATFORM_REVENUE, GATEWAY_SETTLEMENT, SUPPLIER_PAYABLE, TAX_PAYABLE
  ownerId   String? @db.VarChar(191) // userId, supplierId, or '#platform' sentinel for platform-owned accounts
  currency  String @default("IRR") @db.VarChar(10)

  entries LedgerEntry[]

  // Platform accounts share the '#platform' sentinel for clean uniqueness scoping.
  @@unique([ownerType, ownerId, currency])
}

model LedgerEntry {
  id            String   @id @default(cuid()) @db.VarChar(191)
  groupId       String   @db.VarChar(191) // Idempotency / Transaction grouping (Non-unique so double entry pairs share groupId)
  accountId     String   @db.VarChar(191)
  direction     String   @db.VarChar(20) // DEBIT, CREDIT
  amount        Decimal  @db.Decimal(20, 4)
  currency      String   @db.VarChar(10)
  fxRate        Decimal  @default(1.0) @db.Decimal(20, 4)
  baseAmount    Decimal? @db.Decimal(20, 4)
  referenceType String?  @db.VarChar(50) // BOOKING, REFUND, TOPUP, SETTLEMENT, TAX, FEE, FX_SPREAD
  referenceId   String?  @db.VarChar(191)
  createdAt     DateTime @default(now())

  account Account @relation(fields: [accountId], references: [id])

  @@index([accountId])
  @@index([groupId])
}

model PaymentIntent {
  id             String   @id @default(cuid()) @db.VarChar(191)
  bookingId      String   @db.VarChar(191)
  amount         Decimal  @db.Decimal(20, 4)
  currency       String   @default("IRR") @db.VarChar(10)
  status         String   @default("INITIATED") @db.VarChar(50) // INITIATED, AUTHORIZED, CAPTURED, FAILED, VOIDED, PARTIALLY_REFUNDED, REFUNDED
  idempotencyKey String   @unique @db.VarChar(191)
  expiresAt      DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  attempts PaymentAttempt[]
  payments Payment[]

  @@index([bookingId])
  @@index([status])
}

model PaymentAttempt {
  id              String   @id @default(cuid()) @db.VarChar(191)
  paymentIntentId String   @db.VarChar(191)
  gatewayName     String   @db.VarChar(100) // e.g. "SHETAB_SAMAN", "STRIPE", "WECHAT_PAY"
  method          String   @db.VarChar(50) // card, wallet, qr
  amount          Decimal  @db.Decimal(20, 4)
  currency        String   @default("IRR") @db.VarChar(10)
  status          String   @default("INITIATED") @db.VarChar(50) // INITIATED, PENDING_CUSTOMER, SUCCESS, FAILED
  gatewayRef      String?  @db.VarChar(191)
  rawPayload      String?  @db.Text // JSON
  errorMessage    String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  paymentIntent PaymentIntent        @relation(fields: [paymentIntentId], references: [id], onDelete: Cascade)
  transactions  GatewayTransaction[]

  @@index([paymentIntentId])
  @@index([gatewayRef])
}

model GatewayTransaction {
  id              String   @id @default(cuid()) @db.VarChar(191)
  attemptId       String   @db.VarChar(191)
  gatewayName     String   @db.VarChar(100)
  gatewayRef      String   @db.VarChar(191)
  transactionType String   @db.VarChar(50) // SALE, CAPTURE, VOID, REFUND, VERIFY
  amount          Decimal  @db.Decimal(20, 4)
  currency        String   @default("IRR") @db.VarChar(10)
  status          String   @db.VarChar(50) // SUCCESS, FAILED, PENDING
  responseCode    String?  @db.VarChar(50)
  rawResponse     String?  @db.Text // JSON
  createdAt       DateTime @default(now())

  attempt PaymentAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@index([attemptId])
  @@index([gatewayRef])
}

model WebhookEvent {
  id              String    @id @default(cuid()) @db.VarChar(191)
  gatewayName     String    @db.VarChar(100)
  eventId         String    @db.VarChar(191)
  eventType       String    @db.VarChar(100)
  signature       String?   @db.VarChar(255)
  payload         String    @db.Text // JSON
  status          String    @default("RECEIVED") @db.VarChar(50) // RECEIVED, VERIFIED, PROCESSED, REJECTED, DUPLICATE
  processedAt     DateTime?
  rejectionReason String?   @db.Text
  createdAt       DateTime  @default(now())

  @@unique([gatewayName, eventId])
  @@index([status])
}

model Payment {
  id              String   @id @default(cuid()) @db.VarChar(191)
  bookingId       String?  @db.VarChar(191)
  paymentIntentId String?  @db.VarChar(191) // Canonical trace chain: Payment → PaymentIntent → Attempts (PAY-004)
  idempotencyKey  String   @unique @db.VarChar(191)
  method          String   @db.VarChar(50) // wallet_irr, gateway_shetab, wallet_usdt, wechat_pay, telegram_pay, etc
  gatewayRef      String?  @db.VarChar(191)
  amount          Decimal  @db.Decimal(20, 4)
  currency        String   @default("IRR") @db.VarChar(10)
  status          String   @default("PENDING") @db.VarChar(50) // PENDING, SUCCESS, FAILED, REFUNDED
  rawPayload      String?  @db.Text // JSON
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  paymentIntent PaymentIntent? @relation(fields: [paymentIntentId], references: [id], onDelete: SetNull)

  @@index([bookingId])
  @@index([paymentIntentId])
  @@index([idempotencyKey])
}

model DestinationBankCard {
  id            String   @id @default(cuid())
  bankName      String
  accountHolder String
  cardNumber    String
  iban          String?
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  note          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  receipts      CardTransferReceipt[]

  @@index([isActive])
}

model CardTransferReceipt {
  id              String               @id @default(cuid())
  bookingId       String
  paymentIntentId String?
  bankCardId      String?
  amount          Decimal
  currency        String               @default("IRR")
  trackingCode    String?
  paymentDate     DateTime?
  customerNote    String?
  receiptImages   String               // JSON array of image URLs: ["/uploads/receipts/..."]
  nationalIdImage String?
  status          String               @default("PENDING_REVIEW") // PENDING_REVIEW, APPROVED, REJECTED
  reviewerId      String?
  reviewedAt      DateTime?
  adminNote       String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  booking         Booking              @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  bankCard        DestinationBankCard? @relation(fields: [bankCardId], references: [id], onDelete: SetNull)

  @@index([bookingId])
  @@index([status])
}

model DestinationCryptoWallet {
  id            String   @id @default(cuid())
  network       String   // "TRC20", "BEP20", "TON", "ERC20"
  currency      String   @default("USDT")
  walletAddress String
  networkLabel  String
  memoOrTag     String?
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  note          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  receipts      CryptoPaymentReceipt[]

  @@index([isActive])
  @@index([network])
}

model CryptoPaymentReceipt {
  id              String                   @id @default(cuid())
  bookingId       String
  paymentIntentId String?
  cryptoWalletId  String?
  network         String                   // "TRC20"
  currency        String                   @default("USDT")
  amountUsdt      Decimal
  amountIrr       Decimal
  fxRate          Decimal
  txHash          String
  senderAddress   String?
  receiptImage    String?
  onChainVerified Boolean                  @default(false)
  onChainData     String?                  // JSON response from block explorer
  status          String                   @default("PENDING_REVIEW") // PENDING_REVIEW, APPROVED, REJECTED
  reviewerId      String?
  reviewedAt      DateTime?
  adminNote       String?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  booking         Booking                  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  cryptoWallet    DestinationCryptoWallet? @relation(fields: [cryptoWalletId], references: [id], onDelete: SetNull)

  @@index([bookingId])
  @@index([txHash])
  @@index([status])
}

// ==================== 3. Core: Trip & Booking State Machine ====================

model Trip {
  id             String   @id @default(cuid()) @db.VarChar(191)
  reference      String   @unique @db.VarChar(100) // e.g., TRP-10021
  userId         String   @db.VarChar(191)
  organizationId String?  @db.VarChar(191) // B2B Multi-tenancy (IAM-103)
  branchId       String?  @db.VarChar(191) // B2B Branch Scoping (IAM-103)
  title          String   @default("My Journey") @db.VarChar(255)
  status         String   @default("PLANNING") @db.VarChar(50) // PLANNING, BOOKED, IN_PROGRESS, COMPLETED, CANCELLED
  startDate      String?  @db.VarChar(50) // YYYY-MM-DD
  endDate        String?  @db.VarChar(50) // YYYY-MM-DD
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization?       @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  branch       OrganizationBranch? @relation(fields: [branchId], references: [id], onDelete: SetNull)
  bookings     Booking[]

  @@index([userId])
  @@index([organizationId])
  @@index([branchId])
  @@index([status])
}

model Booking {
  id              String   @id @default(cuid())
  reference       String   @unique // e.g., ITR-10023
  tripId          String?
  customerId      String
  organizationId  String?  // B2B Multi-tenancy (IAM-002)
  branchId        String?  // B2B Branch Scoping
  status          String   @default("DRAFT") // DRAFT, HELD, PENDING_PAYMENT, PAYMENT_CONFIRMED, CONFIRMING_SUPPLIER, CONFIRMED, CANCEL_REQUESTED, CANCELLING, CANCELLED, REFUND_INITIATED, REFUNDED, EXPIRED, FAILED
  paymentStatus   String   @default("INITIATED") // INITIATED, AUTHORIZED, CAPTURED, FAILED, VOIDED, PARTIALLY_REFUNDED, REFUNDED
  fulfillmentStatus String @default("PENDING")   // PENDING, IN_PROGRESS, CONFIRMED, FAILED
  ticketStatus    String   @default("NOT_ISSUED") // NOT_ISSUED, ISSUING, ISSUED, VOIDED, REFUND_PENDING, REFUNDED
  totalAmount     Decimal  
  currency        String   @default("IRR")
  travelDate      String?  // Primary travel date (YYYY-MM-DD), queryable — mirrors the details snapshot
  
  supplierId      String?  
  externalPnr     String?  // GDS reference
  holdToken       String?  @unique
  policySnapshot  String?  // JSON
  stateHistory    String?  // Legacy JSON array of transitions (retained for backward compat)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  expiresAt       DateTime? // For payment deadline / Soft Lock
  cancelledAt     DateTime?
  
  customer        User                @relation(fields: [customerId], references: [id])
  trip            Trip?               @relation(fields: [tripId], references: [id], onDelete: SetNull)
  organization    Organization?       @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  branch          OrganizationBranch? @relation(fields: [branchId], references: [id], onDelete: SetNull)
  items           BookingItem[]
  refunds         Refund[]
  statusHistory   BookingStatusHistory[]
  priceSnapshots  PriceSnapshot[]
  autoBuyRules    AutoBuyRule[]
  referral        BookingReferral?
  cardReceipts    CardTransferReceipt[]
  cryptoReceipts  CryptoPaymentReceipt[]
  @@index([customerId])
  @@index([organizationId])
  @@index([branchId])
  @@index([tripId])
  @@index([status])
  @@index([paymentStatus])
  @@index([travelDate])
}

model BookingStatusHistory {
  id            String   @id @default(cuid()) @db.VarChar(191)
  bookingId     String   @db.VarChar(191)
  fromStatus    String   @db.VarChar(50)
  toStatus      String   @db.VarChar(50)
  actor         String   @default("SYSTEM") @db.VarChar(191) // User ID or SYSTEM
  reason        String?  @db.Text
  correlationId String?  @db.VarChar(191)
  createdAt     DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([createdAt])
}

model PriceSnapshot {
  id             String   @id @default(cuid()) @db.VarChar(191)
  bookingId      String   @db.VarChar(191)
  baseAmount     Decimal  @db.Decimal(20, 4)
  markupAmount   Decimal  @default(0) @db.Decimal(20, 4)
  serviceFee     Decimal  @default(0) @db.Decimal(20, 4)
  taxAmount      Decimal  @default(0) @db.Decimal(20, 4)
  discountAmount Decimal  @default(0) @db.Decimal(20, 4)
  sellPrice      Decimal  @db.Decimal(20, 4)
  currency       String   @default("IRR") @db.VarChar(10)
  fxRate         Decimal  @default(1.0) @db.Decimal(20, 4)
  baseCurrency   String?  @default("IRR") @db.VarChar(10)
  breakdownJson  String?  @db.Text // Detailed line items and rules applied
  createdAt      DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
}

// Refund Domain & Reconciliation (REF-001, REF-002)
model Refund {
  id              String    @id @default(cuid()) @db.VarChar(191)
  refundNumber    String    @unique @db.VarChar(100) // e.g. RFD-2026-0001
  bookingId       String    @db.VarChar(191)
  amount          Decimal   @db.Decimal(20, 4)
  penaltyAmount   Decimal   @default(0) @db.Decimal(20, 4)
  netRefundAmount Decimal   @db.Decimal(20, 4)
  currency        String    @default("IRR") @db.VarChar(10)
  status          String    @default("REQUESTED") @db.VarChar(50) // REQUESTED, ELIGIBILITY_CHECKED, APPROVED, SETTLED, COMPLETED, REJECTED
  reason          String?   @db.Text
  idempotencyKey  String    @unique @db.VarChar(191)
  approvedBy      String?   @db.VarChar(191)
  settledAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  booking        Booking               @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  items          RefundItem[]
  policySnapshot RefundPolicySnapshot?
  approvals      RefundApproval[]
  attempts       RefundAttempt[]

  @@index([bookingId])
  @@index([status])
}

// Immutable policy inputs captured when the refund was requested (REF-004)
model RefundPolicySnapshot {
  id                     String   @id @default(cuid()) @db.VarChar(191)
  refundId               String   @unique @db.VarChar(191)
  bookingId              String   @db.VarChar(191)
  bookingStatusAtRequest String   @db.VarChar(50)
  penaltyPercentage      Decimal  @db.Decimal(20, 4)
  policyVersion          String   @default("v1") @db.VarChar(50)
  rulesJson              String   @default("{}") @db.Text // Immutable rule inputs (gross, penalty, net, reason)
  capturedAt             DateTime @default(now())

  refund Refund @relation(fields: [refundId], references: [id], onDelete: Cascade)

  @@index([bookingId])
}

// Human/automated approval trail (REF-005)
model RefundApproval {
  id         String   @id @default(cuid()) @db.VarChar(191)
  refundId   String   @db.VarChar(191)
  approverId String   @db.VarChar(191) // User id or SYSTEM
  decision   String   @db.VarChar(50) // APPROVED, REJECTED
  note       String?  @db.Text
  decidedAt  DateTime @default(now())

  refund Refund @relation(fields: [refundId], references: [id], onDelete: Cascade)

  @@index([refundId])
}

// Execution attempts of the actual money movement (REF-006)
model RefundAttempt {
  id            String   @id @default(cuid()) @db.VarChar(191)
  refundId      String   @db.VarChar(191)
  attemptNumber Int      @default(1)
  channel       String   @db.VarChar(50) // WALLET, GATEWAY, MANUAL
  amount        Decimal  @db.Decimal(20, 4)
  currency      String   @default("IRR") @db.VarChar(10)
  status        String   @default("PENDING") @db.VarChar(50) // PENDING, SUCCESS, FAILED
  gatewayRef    String?  @db.VarChar(191)
  errorMessage  String?  @db.Text
  attemptedAt   DateTime @default(now())

  refund Refund @relation(fields: [refundId], references: [id], onDelete: Cascade)

  @@unique([refundId, attemptNumber])
  @@index([refundId])
}

model RefundItem {
  id            String  @id @default(cuid()) @db.VarChar(191)
  refundId      String  @db.VarChar(191)
  bookingItemId String  @db.VarChar(191)
  amount        Decimal @db.Decimal(20, 4)
  penalty       Decimal @default(0) @db.Decimal(20, 4)
  netAmount     Decimal @db.Decimal(20, 4)
  currency      String  @default("IRR") @db.VarChar(10)

  refund      Refund      @relation(fields: [refundId], references: [id], onDelete: Cascade)
  bookingItem BookingItem @relation(fields: [bookingItemId], references: [id], onDelete: Cascade)

  @@index([refundId])
  @@index([bookingItemId])
}

// Invoicing & Commercial Billing (FIN-006)
model Invoice {
  id             String    @id @default(cuid()) @db.VarChar(191)
  invoiceNumber  String    @unique @db.VarChar(100) // e.g. INV-2026-0001
  bookingId      String    @db.VarChar(191)
  customerId     String    @db.VarChar(191)
  organizationId String?   @db.VarChar(191) // B2B Multi-tenancy (IAM-103)
  branchId       String?   @db.VarChar(191) // B2B Branch Scoping (IAM-103)
  totalAmount    Decimal   @db.Decimal(20, 4)
  taxAmount      Decimal   @default(0) @db.Decimal(20, 4)
  netAmount      Decimal   @db.Decimal(20, 4)
  currency       String    @default("IRR") @db.VarChar(10)
  status         String    @default("ISSUED") @db.VarChar(50) // ISSUED, PAID, VOIDED, REFUNDED
  issuedAt       DateTime  @default(now())
  dueAt          DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization?       @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  branch       OrganizationBranch? @relation(fields: [branchId], references: [id], onDelete: SetNull)
  lines        InvoiceLine[]

  @@index([bookingId])
  @@index([customerId])
  @@index([organizationId])
  @@index([branchId])
  @@index([status])
}

model InvoiceLine {
  id          String  @id @default(cuid()) @db.VarChar(191)
  invoiceId   String  @db.VarChar(191)
  description String  @db.Text
  quantity    Int     @default(1)
  unitPrice   Decimal @db.Decimal(20, 4)
  totalPrice  Decimal @db.Decimal(20, 4)
  taxAmount   Decimal @default(0) @db.Decimal(20, 4)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

// Commission Engine & Multi-Tier Partner Rules (COMM-001)
model CommissionRule {
  id             String    @id @default(cuid()) @db.VarChar(191)
  name           String    @db.VarChar(191)
  targetType     String    @db.VarChar(50) // "AGENCY", "AGENT", "AFFILIATE", "PARTNER"
  targetId       String?   @db.VarChar(191) // Specific organizationId or null for global
  productType    String    @db.VarChar(50) // "FLIGHT", "HOTEL", "TOUR", "ALL"
  ratePercentage Decimal   @default(0.0) @db.Decimal(20, 4) // e.g. 0.05 for 5%
  fixedFee       Decimal   @default(0.0) @db.Decimal(20, 4)
  currency       String    @default("IRR") @db.VarChar(10)
  validFrom      DateTime  @default(now())
  validTo        DateTime?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([targetType, targetId])
  @@index([productType])
}

// Supplier Settlement Batches (SET-001)
model SettlementBatch {
  id              String   @id @default(cuid()) @db.VarChar(191)
  batchNumber     String   @unique @db.VarChar(100) // e.g. STLB-2026-W36
  supplierId      String   @db.VarChar(191)
  organizationId  String?  @db.VarChar(191) // B2B Multi-tenancy (IAM-103)
  branchId        String?  @db.VarChar(191) // B2B Branch Scoping (IAM-103)
  periodStart     DateTime
  periodEnd       DateTime
  totalPayable    Decimal  @db.Decimal(20, 4)
  totalDeductions Decimal  @default(0) @db.Decimal(20, 4)
  netSettlement   Decimal  @db.Decimal(20, 4)
  currency        String   @default("IRR") @db.VarChar(10)
  status          String   @default("OPEN") @db.VarChar(50) // OPEN, SUBMITTED, RECONCILED, COMPLETED
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization Organization?       @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  branch       OrganizationBranch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([supplierId])
  @@index([organizationId])
  @@index([branchId])
  @@index([status])
}

model BookingItem {
  id              String   @id @default(cuid()) @db.VarChar(191)
  bookingId       String   @db.VarChar(191)
  inventoryItemId String?  @db.VarChar(191)
  type            String   @db.VarChar(50) // FLIGHT, HOTEL, VISA, TOUR, TRANSFER, etc
  netCost         Decimal  @db.Decimal(20, 4) // cost from supplier
  markup          Decimal  @db.Decimal(20, 4) // platform profit
  taxAmount       Decimal  @default(0) @db.Decimal(20, 4)
  feeAmount       Decimal  @default(0) @db.Decimal(20, 4)
  sellPrice       Decimal  @db.Decimal(20, 4) // final price for customer
  details         String   @default("{}") @db.Text // JSON details

  booking       Booking        @relation(fields: [bookingId], references: [id])
  inventoryItem InventoryItem? @relation(fields: [inventoryItemId], references: [id])
  refundItems   RefundItem[]

  @@index([bookingId])
  @@index([inventoryItemId])
}

// ==================== 4. Suppliers & Inventory Engine ====================

model Supplier {
  id        String   @id @default(cuid()) @db.VarChar(191)
  name      String   @db.VarChar(191)
  type      String   @db.VarChar(50) // HOTEL | AIRLINE | TOUR_OPERATOR | INSURANCE
  mode      String   @default("ALLOTMENT") @db.VarChar(50) // REALTIME_API, ALLOTMENT, ON_REQUEST
  contact   String?  @db.VarChar(255)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  inventoryItems InventoryItem[]
  contracts      SupplierContract[]
  connections    SupplierConnection[]
  healthRecords  SupplierHealth[]
  statements     SupplierStatement[]

  @@index([type])
}

// Supplier Connection & Credential Reference (SUP-001)
model SupplierConnection {
  id          String   @id @default(cuid()) @db.VarChar(191)
  supplierId  String   @db.VarChar(191)
  productType String   @db.VarChar(50) // "FLIGHT", "HOTEL", "TRANSFER"
  baseUrl     String   @db.VarChar(255)
  environment String   @default("PRODUCTION") @db.VarChar(50) // PRODUCTION, SANDBOX, DEMO
  timeoutMs   Int      @default(5000)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  supplier    Supplier             @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  credentials SupplierCredential[]

  @@index([supplierId])
}

model SupplierCredential {
  id                   String    @id @default(cuid()) @db.VarChar(191)
  supplierConnectionId String    @db.VarChar(191)
  credentialRef        String    @db.VarChar(255) // Secret vault key reference (never plaintext)
  expiresAt            DateTime?
  rotationState        String    @default("ACTIVE") @db.VarChar(50) // ACTIVE, ROTATING, DEPRECATED
  createdAt            DateTime  @default(now())

  connection SupplierConnection @relation(fields: [supplierConnectionId], references: [id], onDelete: Cascade)

  @@index([supplierConnectionId])
}

model SupplierHealth {
  id          String   @id @default(cuid()) @db.VarChar(191)
  supplierId  String   @db.VarChar(191)
  successRate Float    @default(100.0) // Percentage 0 - 100
  timeoutRate Float    @default(0.0)
  latencyP50  Int      @default(350) // Milliseconds
  latencyP95  Int      @default(900)
  errorRate   Float    @default(0.0)
  windowStart DateTime @default(now())
  windowEnd   DateTime @default(now())

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([supplierId])
}

model SupplierStatement {
  id              String   @id @default(cuid()) @db.VarChar(191)
  supplierId      String   @db.VarChar(191)
  statementNumber String   @unique @db.VarChar(100) // e.g. STMT-MAHAN-2026-09
  periodStart     DateTime
  periodEnd       DateTime
  totalAmount     Decimal  @db.Decimal(20, 4)
  currency        String   @default("IRR") @db.VarChar(10)
  status          String   @default("PENDING") @db.VarChar(50) // PENDING, RECONCILED, DISCREPANCY, SETTLED
  rawJson         String?  @db.Text // Statement lines snapshot
  createdAt       DateTime @default(now())

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([supplierId])
}

model SupplierContract {
  id          String   @id @default(cuid()) @db.VarChar(191)
  supplierId  String   @db.VarChar(191)
  pricingType String   @default("NET_RATE") @db.VarChar(50) // NET_RATE, COMMISSION
  commission  Decimal  @default(0.0) @db.Decimal(20, 4)
  creditLimit Decimal  @default(0) @db.Decimal(20, 4)
  currency    String   @default("IRR") @db.VarChar(10)
  termsJson   String   @default("{}") @db.Text
  createdAt   DateTime @default(now())

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([supplierId])
}

model InventoryItem {
  id         String   @id @default(cuid()) @db.VarChar(191)
  supplierId String   @db.VarChar(191)
  type       String   @db.VarChar(50) // HOTEL_ROOM, FLIGHT_SEAT, TOUR_SLOT
  code       String?  @db.VarChar(100) // e.g. H1_ROOM_DELUXE
  name       String   @db.VarChar(255)
  basePrice  Decimal  @db.Decimal(20, 4)
  currency   String   @default("IRR") @db.VarChar(10)

  supplier     Supplier        @relation(fields: [supplierId], references: [id])
  allotments   Allotment[]
  holds        InventoryHold[]
  bookingItems BookingItem[]

  @@index([supplierId])
}

model Allotment {
  id              String  @id @default(cuid()) @db.VarChar(191)
  inventoryItemId String  @db.VarChar(191)
  date            String  @db.VarChar(50) // YYYY-MM-DD
  total           Int     @default(1)
  booked          Int     @default(0)
  stopSell        Boolean @default(false)

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@unique([inventoryItemId, date])
  @@index([date])
}

model InventoryHold {
  id              String   @id @default(cuid()) @db.VarChar(191)
  inventoryItemId String   @db.VarChar(191)
  allotmentDate   String   @db.VarChar(50) // YYYY-MM-DD
  token           String   @unique @db.VarChar(191)
  quantity        Int      @default(1)
  bookingId       String?  @db.VarChar(191)
  expiresAt       DateTime
  status          String   @default("ACTIVE") @db.VarChar(50) // ACTIVE, CAPTURED, RELEASED, EXPIRED
  createdAt       DateTime @default(now())

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([expiresAt])
  @@index([bookingId])
}

// ==================== 5. Reliability & Workflow ====================

model AuditLog {
  id             String   @id @default(cuid()) @db.VarChar(191)
  userId         String?  @db.VarChar(191)
  organizationId String?  @db.VarChar(191)
  action         String   @db.VarChar(100)
  resource       String   @db.VarChar(100)
  resourceId     String   @db.VarChar(191)
  oldData        String?  @db.Text // JSON
  newData        String?  @db.Text // JSON
  reason         String?  @db.Text // Mandatory for sensitive actions (AUD-001)
  requestId      String?  @db.VarChar(191)
  correlationId  String?  @db.VarChar(191)
  ipAddress      String?  @db.VarChar(50)
  userAgent      String?  @db.Text
  createdAt      DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([resource, resourceId])
  @@index([correlationId])
  @@index([organizationId])
}

model OutboxEvent {
  id            String    @id @default(cuid()) @db.VarChar(191)
  eventType     String    @db.VarChar(100) // e.g., "BOOKING_PAID", "BOOKING_CONFIRMED", "REFUND_REQUESTED", "AUTH_OTP_REQUESTED", "VOUCHER_ISSUED", "NOTIFICATION_SENT"
  aggregateType String?   @db.VarChar(100) // e.g., "BOOKING", "PAYMENT", "INVENTORY", "REFUND"
  aggregateId   String?   @db.VarChar(191)
  correlationId String?   @db.VarChar(191)
  causationId   String?   @db.VarChar(191)
  payload       String    @db.Text // JSON
  status        String    @default("PENDING") @db.VarChar(50) // PENDING, CLAIMED, PROCESSING, PROCESSED, FAILED, DEAD_LETTER
  availableAt   DateTime  @default(now())
  lockedAt      DateTime?
  workerId      String?   @db.VarChar(191)
  retryCount    Int       @default(0)
  lastError     String?   @db.Text
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  processedAt   DateTime?

  @@index([status, availableAt])
  @@index([aggregateType, aggregateId])
  @@index([correlationId])
}

// Durable Saga Execution Engine (ASYNC-003)
model SagaExecution {
  id            String    @id @default(cuid()) @db.VarChar(191)
  sagaType      String    @db.VarChar(100) // e.g., "CONFIRM_BOOKING_SAGA", "CANCEL_REFUND_SAGA"
  aggregateType String    @db.VarChar(100) // "BOOKING"
  aggregateId   String    @db.VarChar(191)
  correlationId String?   @db.VarChar(191)
  status        String    @default("PENDING") @db.VarChar(50) // PENDING, RUNNING, SUCCEEDED, FAILED, COMPENSATING, COMPENSATED
  currentStep   String?   @db.VarChar(100)
  contextJson   String    @default("{}") @db.Text // JSON
  startedAt     DateTime  @default(now())
  finishedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  steps SagaStep[]

  @@index([aggregateId])
  @@index([status])
}

model SagaStep {
  id             String    @id @default(cuid()) @db.VarChar(191)
  sagaId         String    @db.VarChar(191)
  stepType       String    @db.VarChar(100) // e.g., "LOCK_INVENTORY", "CAPTURE_PAYMENT", "CALL_SUPPLIER", "POST_LEDGER"
  status         String    @default("PENDING") @db.VarChar(50) // PENDING, RUNNING, SUCCEEDED, FAILED, COMPENSATED
  attempts       Int       @default(0)
  inputSnapshot  String?   @db.Text // JSON
  resultSnapshot String?   @db.Text // JSON
  error          String?   @db.Text
  startedAt      DateTime?
  finishedAt     DateTime?

  saga SagaExecution @relation(fields: [sagaId], references: [id], onDelete: Cascade)

  @@index([sagaId])
  @@index([status])
}

// Server-issued one-time passcodes for passwordless login.
// The code itself is never stored in plaintext.
model OtpVerification {
  id         String    @id @default(cuid()) @db.VarChar(191)
  identifier String    @db.VarChar(191)
  channel    String    @db.VarChar(50) // phone, email, telegram, whatsapp, wechat
  codeHash   String    @db.VarChar(255)
  attempts   Int       @default(0)
  consumedAt DateTime?
  expiresAt  DateTime
  createdAt  DateTime  @default(now())

  @@index([identifier, createdAt])
  @@index([identifier, consumedAt, expiresAt, createdAt])
}

// Exception Center & Discrepancy Registry (RECON-003, Section 24)
model OperationalException {
  id          String    @id @default(cuid()) @db.VarChar(191)
  type        String    @db.VarChar(100) // PRICE_MISMATCH, PAYMENT_MISMATCH, SUPPLIER_TIMEOUT, TICKET_NOT_ISSUED, REFUND_TIMEOUT, FX_VARIANCE, DUPLICATE_BOOKING
  severity    String    @default("MEDIUM") @db.VarChar(50) // LOW, MEDIUM, HIGH, CRITICAL
  entityType  String    @db.VarChar(100) // "BOOKING", "PAYMENT", "SUPPLIER", "INVENTORY"
  entityId    String    @db.VarChar(191)
  title       String    @db.VarChar(255)
  description String?   @db.Text
  status      String    @default("OPEN") @db.VarChar(50) // OPEN, ACKNOWLEDGED, IN_PROGRESS, RESOLVED, CLOSED
  ownerId     String?   @db.VarChar(191)
  slaDueAt    DateTime?
  detectedAt  DateTime  @default(now())
  resolution  String?   @db.Text
  closedAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, severity])
  @@index([entityType, entityId])
}

// Versioned Tax Engine (MONEY-003, Section 4)
model TaxJurisdiction {
  id          String    @id @default(cuid()) @db.VarChar(191)
  code        String    @unique @db.VarChar(50) // e.g. "IR", "CN", "AE", "TR"
  name        String    @db.VarChar(191)
  countryCode String    @db.VarChar(10)
  rules       TaxRule[]

  @@index([countryCode])
}

model TaxRule {
  id             String    @id @default(cuid()) @db.VarChar(191)
  jurisdictionId String    @db.VarChar(191)
  category       String    @db.VarChar(50) // "GENERAL", "FLIGHT", "HOTEL", "TOUR", "TRANSFER", "EXEMPT"
  ratePercentage Decimal   @db.Decimal(20, 4) // e.g. 0.09 for 9%
  effectiveFrom  DateTime  @default(now())
  effectiveTo    DateTime?
  isActive       Boolean   @default(true)
  description    String?   @db.Text
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  jurisdiction TaxJurisdiction @relation(fields: [jurisdictionId], references: [id], onDelete: Cascade)

  @@index([jurisdictionId, category])
  @@index([effectiveFrom, effectiveTo])
}

// ==================== Auto-Buy / Smart Purchase Rules ====================
model AutoBuyRule {
  id               String    @id @default(cuid()) @db.VarChar(191)
  userId           String    @db.VarChar(191)
  title            String    @db.VarChar(255)
  serviceType      String    @db.VarChar(50) // TOURS, FLIGHTS, HOTELS
  targetId         String?   @db.VarChar(191) // tour ID, hotel ID, flight number
  origin           String?   @db.VarChar(100)
  destination      String?   @db.VarChar(100)
  targetDate       String    @db.VarChar(50) // YYYY-MM-DD
  maxPrice         Decimal   @db.Decimal(20, 4)
  currency         String    @default("IRR") @db.VarChar(10)
  passengerCount   Int       @default(1)
  passengerDetails String    @db.Text // JSON string of passengers
  executionMode    String    @default("ON_CONDITIONS_MET") @db.VarChar(50) // ON_PRICE_DROP, ON_SCHEDULED_TIME, ON_INVENTORY_AVAILABLE, ON_CONDITIONS_MET
  status           String    @default("ACTIVE") @db.VarChar(50) // ACTIVE, TRIGGERED, FULFILLED, FAILED_FUNDS, CANCELLED, EXPIRED
  scheduledAt      DateTime?
  lastCheckedAt    DateTime?
  bookingId        String?   @db.VarChar(191)
  failureReason    String?   @db.Text
  expiresAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@index([serviceType])
  @@index([targetDate])
}

// ==================== Content Management: Tours, Experiences, Travelogues & Guides ====================

model Tour {
  id              String   @id @default(cuid()) @db.VarChar(191)
  title           String   @db.VarChar(255)
  titleEn         String   @db.VarChar(255)
  city            String   @db.VarChar(100)
  cityEn          String?  @db.VarChar(100)
  country         String   @default("ایران") @db.VarChar(100)
  countryEn       String?  @default("Iran") @db.VarChar(100)
  durationDays    Int      @default(3)
  durationNights  Int      @default(2)
  price           Decimal  @db.Decimal(20, 4)
  childPrice      Decimal? @db.Decimal(20, 4)
  rating          Float    @default(5.0)
  reviewsCount    Int      @default(0)
  category        String   @default("cultural") @db.VarChar(50) // cultural, nature, medical, adventure
  heroImage       String?  @db.Text
  gallery         Json?
  summary         String?  @db.Text
  summaryEn       String?  @db.Text
  description     String?  @db.Text
  descriptionEn   String?  @db.Text
  highlights      Json?
  includes        Json?
  excludes        Json?
  hotelName       String?  @db.VarChar(255)
  hotelStars      Int?     @default(5)
  transportType   String?  @db.VarChar(100)
  transportTypeEn String?  @db.VarChar(100)
  groupSize       String?  @db.VarChar(100)
  groupSizeEn     String?  @db.VarChar(100)
  guideLanguages  Json?
  isPublished     Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  departureDates TourDepartureDate[]
  itineraryDays  TourItineraryDay[]

  @@index([category])
  @@index([city])
  @@index([isPublished])
}

model TourDepartureDate {
  id             String   @id @default(cuid()) @db.VarChar(191)
  tourId         String   @db.VarChar(191)
  startDate      String   @db.VarChar(50) // YYYY-MM-DD
  endDate        String   @db.VarChar(50) // YYYY-MM-DD
  price          Decimal  @db.Decimal(20, 4)
  childPrice     Decimal? @db.Decimal(20, 4)
  availableSeats Int      @default(10)
  guaranteed     Boolean  @default(true)

  tour Tour @relation(fields: [tourId], references: [id], onDelete: Cascade)

  @@index([tourId])
}

model TourItineraryDay {
  id            String  @id @default(cuid()) @db.VarChar(191)
  tourId        String  @db.VarChar(191)
  day           Int
  title         String  @db.VarChar(255)
  titleEn       String? @db.VarChar(255)
  description   String  @db.Text
  activities    Json?
  breakfast     Boolean @default(false)
  lunch         Boolean @default(false)
  dinner        Boolean @default(false)
  accommodation String? @db.VarChar(255)

  tour Tour @relation(fields: [tourId], references: [id], onDelete: Cascade)

  @@index([tourId])
}

model SignatureExperience {
  id        String   @id @default(cuid()) @db.VarChar(191)
  countryId String   @db.VarChar(50) // iran, turkey, uae, georgia, russia, oman, china
  category  String   @db.VarChar(50) // yacht, festival, culture, nature, wellness, adventure, theater, exhibition, nightlife
  title     String   @db.VarChar(255)
  titleEn   String   @db.VarChar(255)
  desc      String   @db.Text
  descEn    String   @db.Text
  where     String   @db.VarChar(255)
  whereEn   String   @db.VarChar(255)
  when      String   @db.VarChar(255)
  whenEn    String   @db.VarChar(255)
  fromPrice Decimal  @db.Decimal(20, 4)
  image     String?  @db.Text
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([countryId])
  @@index([category])
  @@index([isActive])
}

model Travelogue {
  id          String   @id @default(cuid()) @db.VarChar(191)
  countryId   String   @default("iran") @db.VarChar(50)
  titleFa     String   @db.VarChar(255)
  titleEn     String   @db.VarChar(255)
  destFa      String   @db.VarChar(255)
  destEn      String   @db.VarChar(255)
  userName    String   @db.VarChar(191)
  userAvatar  String?  @db.Text
  image       String   @db.Text
  contentFa   String   @db.Text
  contentEn   String   @db.Text
  likesCount  Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([countryId])
  @@index([isPublished])
}

model GuideArticle {
  id          String   @id @default(cuid()) @db.VarChar(191)
  categoryFa  String   @db.VarChar(100)
  categoryEn  String   @db.VarChar(100)
  titleFa     String   @db.VarChar(255)
  titleEn     String   @db.VarChar(255)
  readTime    String   @default("۵ دقیقه") @db.VarChar(50)
  excerptFa   String   @db.Text
  excerptEn   String   @db.Text
  bodyFa      String   @db.Text
  bodyEn      String   @db.Text
  image       String?  @db.Text
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isPublished])
}

// ==================== Referral & Group Leader System ====================

model ReferralCode {
  id               String   @id @default(cuid()) @db.VarChar(191)
  code             String   @unique @db.VarChar(100) // Uppercase, trimmed unique code (e.g. KOOH123)
  leaderId         String   @db.VarChar(191)
  isActive         Boolean  @default(true)
  customTierConfig String?  @db.Text // Custom JSON overrides for reward tiers if any
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  leader      User               @relation(fields: [leaderId], references: [id], onDelete: Cascade)
  referrals   BookingReferral[]
  settlements LeaderSettlement[]

  @@index([code])
  @@index([leaderId])
}

model BookingReferral {
  id                 String   @id @default(cuid()) @db.VarChar(191)
  bookingId          String   @unique @db.VarChar(191) // Exactly one referral record per booking
  referralCodeId     String?  @db.VarChar(191) // Nullable if code was invalid / unmatched
  rawCode            String   @db.VarChar(100) // Raw entered code (trimmed and uppercase)
  status             String   @default("VALID") @db.VarChar(50) // VALID, UNMATCHED, SELF_REFERRAL, INACTIVE
  paxCount           Int      @default(1) // Confirmed traveler count for this booking
  discountAmount     Decimal  @default(0) @db.Decimal(20, 4) // 5% discount amount in currency
  discountPercent    Decimal  @default(0.05) @db.Decimal(20, 4) // Configured discount percentage applied
  applied            Boolean  @default(true) // Whether the discount was applied or superseded by coupon
  source             String   @default("WEB") @db.VarChar(50) // WEB, ADMIN, PHONE
  registeredByUserId String?  @db.VarChar(191)
  registeredAt       DateTime @default(now())

  booking      Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  referralCode ReferralCode? @relation(fields: [referralCodeId], references: [id], onDelete: SetNull)

  @@index([referralCodeId])
  @@index([status])
  @@index([rawCode])
}

model LeaderSettlement {
  id             String    @id @default(cuid()) @db.VarChar(191)
  referralCodeId String    @db.VarChar(191)
  qualifiedPax   Int // Number of confirmed passengers counted
  rewardPercent  Decimal   @db.Decimal(20, 4) // Reward percentage earned (e.g. 0.25, 0.50, 1.00)
  rewardAmount   Decimal   @db.Decimal(20, 4) // Calculated reward amount (IRR)
  currency       String    @default("IRR") @db.VarChar(10)
  status         String    @default("PENDING") @db.VarChar(50) // PENDING, APPROVED, SETTLED, REJECTED
  settledAt      DateTime?
  settledBy      String?   @db.VarChar(191)
  notes          String?   @db.Text
  createdAt      DateTime  @default(now())

  referralCode ReferralCode @relation(fields: [referralCodeId], references: [id], onDelete: Cascade)

  @@index([referralCodeId])
  @@index([status])
}

// Distributed Worker Lease (ASYNC-102, ASYNC-103)
model WorkerLease {
  resourceName String   @id @db.VarChar(191)
  holderId     String   @db.VarChar(191)
  acquiredAt   DateTime @default(now())
  expiresAt    DateTime
  heartbeatAt  DateTime @default(now())
  version      Int      @default(1)

  @@index([expiresAt])
}
