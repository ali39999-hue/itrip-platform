// Prisma Schema for iTrip/Firuzo Travel Platform - V1 Backend
// Provider: SQLite (Temporary for dev)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ==================== 1. Identity & RBAC ====================

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  phone        String?  @unique
  name         String?
  role         String   @default("CUSTOMER") // SUPER_ADMIN, FINANCE, OPS, CUSTOMER
  passwordHash String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  auditLogs    AuditLog[]
  bookings     Booking[]
  userRoles    UserRole[]
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique // e.g. SUPER_ADMIN, FINANCE_OPS
  permissions String   // JSON array of permission strings
  
  userRoles   UserRole[]
}

model UserRole {
  userId String
  roleId String
  
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

// ==================== 2. Core: Double-Entry Ledger & Payments ====================

model Account {
  id          String        @id @default(cuid())
  ownerType   String        // USER, PLATFORM_ESCROW, PLATFORM_FEE, PLATFORM_REVENUE, GATEWAY_SETTLEMENT, SUPPLIER_PAYABLE
  ownerId     String?       // userId or supplierId
  currency    String        @default("IRR")
  
  entries     LedgerEntry[]
}

model LedgerEntry {
  id            String   @id @default(cuid())
  groupId       String   // Idempotency / Transaction grouping
  accountId     String
  direction     String   // DEBIT, CREDIT
  amount        Decimal  
  currency      String
  fxRate        Decimal  @default(1.0)
  baseAmount    Decimal?
  referenceType String?  // BOOKING, REFUND, TOPUP, SETTLEMENT
  referenceId   String?  
  createdAt     DateTime @default(now())
  
  account       Account  @relation(fields: [accountId], references: [id])

  @@index([groupId])
  @@index([accountId])
}

model Payment {
  id              String   @id @default(cuid())
  bookingId       String?
  idempotencyKey  String   @unique
  method          String   // wallet_irr, gateway_shetab, wallet_usdt, etc
  gatewayRef      String?
  amount          Decimal
  currency        String   @default("IRR")
  status          String   @default("PENDING") // PENDING, SUCCESS, FAILED, REFUNDED
  rawPayload      String?  // JSON
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([bookingId])
  @@index([idempotencyKey])
}

// ==================== 3. Core: Booking State Machine ====================

model Booking {
  id              String   @id @default(cuid())
  reference       String   @unique // e.g., ITR-10023
  customerId      String
  status          String   @default("DRAFT") // DRAFT, HELD, PENDING_PAYMENT, PAYMENT_CONFIRMED, CONFIRMING_SUPPLIER, CONFIRMED, CANCEL_REQUESTED, CANCELLING, CANCELLED, REFUND_INITIATED, REFUNDED, EXPIRED, FAILED
  totalAmount     Decimal  
  currency        String   @default("IRR")
  
  supplierId      String?  
  externalPnr     String?  // GDS reference
  holdToken       String?  @unique
  policySnapshot  String?  // JSON
  stateHistory    String?  // JSON array of transitions
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  expiresAt       DateTime? // For payment deadline / Soft Lock
  cancelledAt     DateTime?
  
  customer        User     @relation(fields: [customerId], references: [id])
  items           BookingItem[]
  
  @@index([customerId])
  @@index([status])
}

model BookingItem {
  id              String   @id @default(cuid())
  bookingId       String
  inventoryItemId String?
  type            String   // FLIGHT, HOTEL, VISA, TOUR, TRANSFER, etc
  netCost         Decimal  // cost from supplier
  markup          Decimal  // platform profit
  sellPrice       Decimal  // final price for customer
  details         String   @default("{}") // JSON details
  
  booking         Booking  @relation(fields: [bookingId], references: [id])
  inventoryItem   InventoryItem? @relation(fields: [inventoryItemId], references: [id])
}

// ==================== 4. Suppliers & Inventory Engine ====================

model Supplier {
  id          String   @id @default(cuid())
  name        String
  type        String   // HOTEL | AIRLINE | TOUR_OPERATOR | INSURANCE
  mode        String   @default("ALLOTMENT") // REALTIME_API, ALLOTMENT, ON_REQUEST
  contact     String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  
  inventoryItems InventoryItem[]
  contracts      SupplierContract[]
}

model SupplierContract {
  id           String   @id @default(cuid())
  supplierId   String
  pricingType  String   @default("NET_RATE") // NET_RATE, COMMISSION
  commission   Decimal  @default(0.0)
  creditLimit  Decimal  @default(0)
  currency     String   @default("IRR")
  termsJson    String   @default("{}")
  createdAt    DateTime @default(now())

  supplier     Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
}

model InventoryItem {
  id          String   @id @default(cuid())
  supplierId  String
  type        String   // HOTEL_ROOM, FLIGHT_SEAT, TOUR_SLOT
  code        String?  // e.g. H1_ROOM_DELUXE
  name        String
  basePrice   Decimal  
  currency    String   @default("IRR")
  
  supplier    Supplier @relation(fields: [supplierId], references: [id])
  allotments  Allotment[]
  holds       InventoryHold[]
  bookingItems BookingItem[]
}

model Allotment {
  id            String   @id @default(cuid())
  inventoryItemId String
  date          String   // YYYY-MM-DD
  total         Int      @default(1)
  booked        Int      @default(0)
  stopSell      Boolean  @default(false)

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@unique([inventoryItemId, date])
  @@index([date])
}

model InventoryHold {
  id              String   @id @default(cuid())
  inventoryItemId String
  allotmentDate   String   // YYYY-MM-DD
  token           String   @unique
  quantity        Int      @default(1)
  bookingId       String?
  expiresAt       DateTime
  status          String   @default("ACTIVE") // ACTIVE, CAPTURED, RELEASED, EXPIRED
  createdAt       DateTime @default(now())

  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([expiresAt])
}

// ==================== 5. Reliability & Workflow ====================

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  action      String
  resource    String
  resourceId  String
  oldData     String?  // JSON
  newData     String?  // JSON
  createdAt   DateTime @default(now())
  
  user        User?    @relation(fields: [userId], references: [id])
  
  @@index([userId])
  @@index([resource, resourceId])
}

model OutboxEvent {
  id          String   @id @default(cuid())
  eventType   String   // e.g., "BOOKING_PAID", "REFUND_REQUESTED"
  payload     String   // JSON
  status      String   @default("PENDING") // PENDING, PROCESSED, FAILED
  createdAt   DateTime @default(now())
}
