# Environment Configuration Template for Firuzo / iTrip Platform
# Copy this file to .env.local and populate with your own secrets.
# NEVER commit real credentials here — placeholders only.

# Database (PostgreSQL default; or MySQL/MariaDB with `npm run db:prepare:mysql`)
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/itrip?schema=public"
# DATABASE_URL="mysql://firuzoreza_usr:your-database-password@127.0.0.1:3306/firuzoreza?connection_limit=10&pool_timeout=10"

# NextAuth Secret (Generate with `openssl rand -base64 32`)
AUTH_SECRET=""
# Alias consumed by next-auth v5 internals; keep in sync with AUTH_SECRET
NEXTAUTH_SECRET=""
AUTH_TRUST_HOST="true"
NEXTAUTH_URL="http://localhost:3000"

# Demo Mode ('true' enables mock bypasses and demo balances; 'false' enforces production auth and ledger)
DEMO_MODE="false"
NEXT_PUBLIC_DEMO_MODE="false"

# Initial seed passwords for admin and standard users
ADMIN_PASSWORD=""
USER_PASSWORD=""

# Site Public URL
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Product Analytics (PostHog funnel events — optional; analytics no-ops when unset)
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://eu.i.posthog.com"

# Google Analytics (optional)
NEXT_PUBLIC_GA_ID=""

# ==========================================
# 1. Google OAuth 2.0 Credentials
# Create OAuth 2.0 Client ID at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
# ==========================================
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""


# ==========================================
# 2. Telegram Bot & Login Widget
# Create bot with @BotFather on Telegram. Set domain via /setdomain to your site host.
# ==========================================
TELEGRAM_BOT_TOKEN=""
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=""

# ==========================================
# 2.1. Bale Messenger Bot (پیام‌رسان بله)
# Create bot with @BotFather on Bale to receive token. 100% free & local.
# ==========================================
BALE_BOT_TOKEN=""
NEXT_PUBLIC_BALE_BOT_USERNAME=""

# ==========================================
# 3. WeChat Open Platform (微信开放平台)
# Register a Website Application at https://open.weixin.qq.com
# Authorized callback domain: yourdomain.com (NextAuth handles
# /api/auth/callback/wechat and /api/auth/callback/wechat_mp automatically)
# WECHAT_APP_ID / WECHAT_APP_SECRET must BOTH be set to enable QR login.
# ==========================================
WECHAT_APP_ID=""
WECHAT_APP_SECRET=""
NEXT_PUBLIC_WECHAT_APP_ID=""

# ==========================================
# 4. WhatsApp Business Integration
# Option A: Meta WhatsApp Cloud API (https://developers.facebook.com)
#   - WHATSAPP_ACCESS_TOKEN + WHATSAPP_PHONE_NUMBER_ID are required
#   - OTP delivery REQUIRES a pre-approved template (business-initiated
#     free-form text is blocked outside the 24h service window):
#     create an "Authentication" template named below with ONE body
#     variable (the code), e.g. "Your Firuzo code is {{1}}".
# Option B: Twilio WhatsApp (https://www.twilio.com)
#   - TWILIO_ACCOUNT_SID + TWILIO_AUTH_TOKEN + TWILIO_WHATSAPP_NUMBER
#   - OTP: pre-register a content template and set TWILIO_WHATSAPP_CONTENT_SID
#     (code is passed as content variable {{1}}).
# ==========================================
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_API_TOKEN=""
WHATSAPP_OTP_TEMPLATE_NAME="otp_verification"
WHATSAPP_OTP_TEMPLATE_LANG="fa"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_NUMBER=""
TWILIO_WHATSAPP_CONTENT_SID=""

# ==========================================
# 5. Email Delivery (Resend API)
# Register at https://resend.com and create an API key
# ==========================================
RESEND_API_KEY=""
EMAIL_FROM="Firuzo Travel <noreply@firuzo.com>"

# ==========================================
# 6. SMS Providers
# SMSWBS (smswbs.ir / sms.hupa.ir) — primary OTP provider for +98 numbers
# ==========================================
SMS_PROVIDER="smswbs"
SMSWBS_USERNAME=""
SMSWBS_PASSWORD=""
SMSWBS_SENDER=""
SMS_SENDER_LINE=""
SMS_OTP_LINE=""
SMS_PATTERN_CODE=""
# Alternative providers (optional)
SMS_PROVIDER_API_KEY=""
KAVENEGAR_API_KEY=""
FARAZ_SMS_API_KEY=""

# ==========================================
# 7. Payment Gateways
# Ecardo Multi-Currency Gateway (ecardo.ir)
# ==========================================
ECARDO_BASE_URL="https://ecardo.ir"
ECARDO_PUBLIC_KEY=""
ECARDO_SECRET_KEY=""
# SHETAB domestic gateway
SHETAB_MERCHANT_ID=""
SHETAB_TERMINAL_ID=""
SHETAB_SECRET_KEY=""
# Gateway selection / runtime mode (see src/lib/runtime-mode.ts)
GATEWAY_MODE=""

# ==========================================
# 7b. Web Push Notifications (VAPID)
# Generate a fresh pair with: npx web-push generate-vapid-keys
# ==========================================
WEB_PUSH_VAPID_PUBLIC_KEY=""
WEB_PUSH_VAPID_PRIVATE_KEY=""
WEB_PUSH_CONTACT="mailto:support@firuzo.com"

# ==========================================
# 8. Infrastructure & Operations
# Redis for distributed rate-limit / queue (optional; falls back to in-memory)
# ==========================================
REDIS_URL=""
# Protects /api/cron/* endpoints (Vercel cron sends it as Bearer token)
CRON_SECRET=""
# 32-char master key for document/vault encryption at rest (dev fallback is insecure)
ENCRYPTION_KEY=""
# Emergency stop for the auto-buy worker ('true' halts new purchases)
AUTO_BUY_KILL_SWITCH="false"
# Verbose Prisma query logging (debug only)
DEBUG_PRISMA="false"

# ==========================================
# 9. FX Rate Provider (currency conversion)
# ==========================================
FX_RATE_API_URL=""
FX_API_KEY=""

# ==========================================
# 10. Supplier Integrations
# Eghamat24 hotel supplier
# ==========================================
EGHAMAT_API_KEY=""
EGHAMAT_ENDPOINT_URL=""
EGHAMAT_AGENCY_CODE=""
# Parto CRS flight supplier (official API v3 — docs/PARTO_LIVE_INTEGRATION_PLAN.fa.md)
# Agency panel credentials; the password is hashed to SHA-512 at call time.
PARTO_CRS_OFFICE_ID=""
PARTO_CRS_USERNAME=""
PARTO_CRS_PASSWORD=""
PARTO_CRS_ENDPOINT_URL="https://api.partocrs.ir"
# Legacy placeholder vars (kept for backward compatibility, unused by the v3 client)
PARTO_API_KEY=""
PARTO_ENDPOINT_URL=""
PARTO_OFFICE_ID=""
# Flight live cache: TTL for cached offers + overlay switch (auto=active only with creds)
FLIGHT_CACHE_TTL_MINUTES="60"
FLIGHT_LIVE_OVERLAY="auto"
FLIGHT_REFRESH_ROUTES_PER_HOUR="12"
# Portal-scrape fallback (when Parto does not grant the API):
# capture a session once with `node scripts/parto-portal-capture.mjs login`.
PARTO_PORTAL_COOKIE=""
PARTO_PORTAL_BASE_URL="https://www.partocrs.ir"
# Price unit shown on the agent portal (verify with the first capture): toman|rial
PARTO_PORTAL_PRICE_UNIT="toman"
# Force the refresh source: auto | api | portal
FLIGHT_REFRESH_SOURCE="auto"

# ==========================================
# 11. Refund Payout (Paya API)
# ==========================================
PAYA_PAYOUT_API_KEY=""
