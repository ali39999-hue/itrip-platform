{
  "name": "itrip-platform",
  "version": "1.5.7",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/auto-setup.mjs",
    "build": "next build",
    "start": "next start",
    "worker": "tsx src/workers/worker-entrypoint.ts",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "gate:i18n": "node scripts/i18n-completeness-gate.mjs",
    "gate:a11y": "node scripts/a11y-baseline.mjs",
    "security:scan": "node scripts/security-scan.mjs",
    "test:unit": "node scripts/run-unit-tests.mjs",
    "test:e2e": "playwright test",
    "postinstall": "prisma generate",
    "db:prepare:mysql": "python scripts/make-mysql-schema.py",
    "prisma:seed": "tsx prisma/seed.ts",
    "db:push:dev-only": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "docker:infra": "docker compose -f docker-compose.infra.yml up -d",
    "docker:infra:down": "docker compose -f docker-compose.infra.yml down",
    "docker:dev": "docker compose -f docker-compose.dev.yml up",
    "docker:dev:build": "docker compose -f docker-compose.dev.yml up --build",
    "docker:prod": "docker compose up -d",
    "docker:prod:build": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:migrate": "docker compose exec app npx prisma migrate deploy",
    "docker:seed": "docker compose exec app npm run prisma:seed"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.9.1",
    "@prisma/client": "^5.22.0",
    "@tanstack/react-query": "^5.102.8",
    "@types/qrcode": "^1.5.6",
    "@vercel/analytics": "^2.0.1",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.33.0",
    "motion": "^13.2.0",
    "next": "^16.3.4",
    "next-auth": "^5.0.0-beta.32",
    "next-intl": "^4.13.7",
    "next-themes": "^0.4.6",
    "posthog-js": "^1.427.2",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-error-boundary": "^6.1.5",
    "react-hook-form": "^7.86.0",
    "react-leaflet": "^5.0.0",
    "react-multi-date-picker": "^4.5.2",
    "shadcn": "^4.19.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "uuid": "^14.0.2",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/bcryptjs": "^2.4.6",
    "@types/jest-axe": "^3.5.9",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "jest-axe": "^11.0.0",
    "jsdom": "^30.0.1",
    "prisma": "^5.22.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "prisma@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "@prisma/client@5.22.0": true
  }
}
